{
  "name": "gridcity-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Grid City VR Avatar Mirror — event-booth kiosk that turns guests into Grid City characters.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch-models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/fetch-models.mjs --if-missing",
    "make-placeholders": "node scripts/make-placeholder-vrm.mjs",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "kalidokit": "^1.1.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
